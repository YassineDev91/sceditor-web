# Copy this file to server/.env and fill in real values. server/.env is
# gitignored (matches the existing ".env" pattern in .gitignore) and must
# never be committed.

# Ollama (local LLM) — the server must be able to reach this URL.
OLLAMA_URL=http://localhost:11434

# Cloud provider keys — leave blank to leave that provider unconfigured.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shared secret the frontend must send as the X-Proxy-Secret header.
# Set this to a random string; leave blank to disable the check entirely
# (not recommended once the proxy is reachable from anywhere but localhost).
PROXY_SHARED_SECRET=change-me

PORT=4000
