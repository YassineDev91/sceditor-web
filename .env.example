# Rename this file to .env and replace the placeholders as needed.
# Note: Vite requires the VITE_ prefix to expose environment variables to the client.
#
# Provider API keys are NOT configured here anymore — they live in
# server/.env (see server/.env.example) and are never exposed to the browser.

# =============================================================================
# LLM Provider Selection (client-side defaults only — no secrets here)
# =============================================================================
# Choose one of: ollama, gemini, openai, anthropic
VITE_AI_PROVIDER=ollama

# Default model per provider (just UI defaults; the user can change these in Settings)
VITE_OLLAMA_MODEL=llama3
VITE_GEMINI_MODEL=gemini-pro
VITE_OPENAI_MODEL=gpt-4
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# LLM Proxy (see server/.env.example for the server-side configuration)
# =============================================================================
# Address of the running proxy server (server/index.js). This is just an
# address, not a secret, so it's safe to expose to the client build.
VITE_PROXY_URL=http://localhost:4000
