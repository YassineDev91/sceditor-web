# Rename this file to .env and replace the placeholders with your actual API configuration
# Note: Vite requires the VITE_ prefix to expose environment variables to the client

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose one of: ollama, gemini, openai, anthropic
VITE_AI_PROVIDER=ollama

# =============================================================================
# Ollama Configuration (Local LLM)
# =============================================================================
# Default Ollama URL (usually runs on localhost:11434)
VITE_OLLAMA_URL=http://localhost:11434
# Model name (e.g., llama3, codellama, mistral, deepseek-coder)
VITE_OLLAMA_MODEL=llama3

# =============================================================================
# Google Gemini Configuration
# =============================================================================
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Model options: gemini-pro, gemini-1.5-pro, gemini-1.5-flash
VITE_GEMINI_MODEL=gemini-pro

# =============================================================================
# OpenAI Configuration
# =============================================================================
VITE_OPENAI_API_KEY=your_openai_api_key_here
# Model options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
VITE_OPENAI_MODEL=gpt-4

# =============================================================================
# Anthropic Claude Configuration
# =============================================================================
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model options: claude-3-5-sonnet-20241022, claude-3-opus-20240229
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022